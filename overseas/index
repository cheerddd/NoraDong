.tl-org{font-size:13px;color:var(--muted);margin-bottom:12px;}
.tl-desc{font-size:14px;line-height:1.85;color:var(--text2);max-width:600px;}

/* PERSONALITY */
.pers-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:32px;}
.pers-card{background:var(--white);border:1px solid var(--border);border-radius:var(--r);padding:40px;position:relative;overflow:hidden;transition:transform .35s,box-shadow .35s;}
.pers-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-m);}
.pers-bg{position:absolute;right:20px;top:8px;font-family:'Playfair Display',serif;font-size:90px;font-weight:700;opacity:.04;line-height:1;pointer-events:none;user-select:none;}
