.pers-title{font-family:'Playfair Display',serif;font-size:42px;font-weight:500;line-height:1;margin-bottom:5px;}
.pers-sub{font-family:'Playfair Display',serif;font-style:italic;font-size:16px;color:var(--text2);margin-bottom:18px;}
.pers-desc{font-size:14px;line-height:1.85;color:var(--muted);}
.char-grid{display:flex;flex-wrap:wrap;gap:10px;}
.char-tag{display:flex;align-items:center;gap:7px;padding:9px 18px;background:var(--white);border:1px solid var(--border);border-radius:100px;font-size:13px;color:var(--text2);transition:all .3s;cursor:default;}
.char-tag:hover{border-color:var(--indigo);color:var(--indigo);background:var(--indigo-l);transform:translateY(-2px);}

/* HOBBIES */
.hobby-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;}
.hb-card{background:var(--white);border:1px solid var(--border);border-radius:var(--r);padding:26px 18px;text-align:center;transition:all .35s;}
.hb-card:hover{border-color:var(--indigo);transform:translateY(-4px);box-shadow:var(--shadow-s);}
.hb-e{font-size:26px;margin-bottom:8px;}
.hb-l{font-size:13px;color:var(--text2);}

/* CONTACT */
.contact-wrap{background:var(--text);border-radius:32px;padding:80px;text-align:center;position:relative;overflow:hidden;margin:0 64px 96px;}
.c-orb1{position:absolute;width:500px;height:500px;background:radial-gradient(circle,rgba(74,92,240,.3) 0%,transparent 70%);top:-150px;right:-80px;border-radius:50%;}
.c-orb2{position:absolute;width:400px;height:400px;background:radial-gradient(circle,rgba(232,84,122,.2) 0%,transparent 70%);bottom:-120px;left:-60px;border-radius:50%;}
