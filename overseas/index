<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nora Dong · 海外产品与解决方案</title>
<meta name="description" content="董宁的海外产品与解决方案作品集，聚焦欧洲与日本客户、智能设备 SaaS、售前方案、端云协同与全球化复杂交付。">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,700;1,400;1,500&family=Outfit:wght@300;400;500;600&family=Noto+Serif+SC:wght@300;400&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #f7f6fa;
  --bg2: #eeecf3;
  --white: #ffffff;
  --border: rgba(34,24,58,0.10);
  --text: #171321;
  --text2: #4f495d;
  --muted: #8e879b;
  --indigo: #7357ff;
  --indigo-l: #f0edff;
  --indigo-m: rgba(115,87,255,0.16);
  --rose: #e8547a;
  --rose-l: #fef0f3;
  --amber: #d4872a;
  --amber-l: #fef6ec;
  --sage: #4a9b7a;
  --sage-l: #edf7f3;
  --shadow-s: 0 8px 24px rgba(31,20,59,0.07);
  --shadow-m: 0 18px 50px rgba(31,20,59,0.12);
  --shadow-l: 0 32px 100px rgba(0,0,0,0.30);
  --r: 20px;
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{background:var(--bg);color:var(--text);font-family:'Outfit',sans-serif;font-weight:300;overflow-x:hidden;cursor:none;}

/* CURSOR */
#cur{width:8px;height:8px;background:var(--indigo);border-radius:50%;position:fixed;top:0;left:0;pointer-events:none;z-index:9999;transition:transform .08s;}
#cur-r{width:32px;height:32px;border:1.5px solid rgba(74,92,240,.4);border-radius:50%;position:fixed;top:0;left:0;pointer-events:none;z-index:9998;transition:width .2s,height .2s,border-color .2s,background .2s;}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:300;padding:20px 64px;display:flex;justify-content:space-between;align-items:center;transition:all .4s;}
nav.scrolled{background:rgba(248,247,243,0.94);backdrop-filter:blur(20px);box-shadow:0 1px 0 var(--border);}
.nav-logo{font-family:'Playfair Display',serif;font-size:20px;font-weight:500;color:var(--text);text-decoration:none;letter-spacing:.04em;}
.nav-links{display:flex;gap:32px;list-style:none;}
.nav-links a{color:var(--muted);text-decoration:none;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;font-weight:400;transition:color .3s;position:relative;}
.nav-links a::after{content:'';position:absolute;bottom:-3px;left:0;width:0;height:1.5px;background:var(--indigo);transition:width .3s;}
.nav-links a:hover,.nav-links a.active{color:var(--indigo);}
.nav-links a:hover::after,.nav-links a.active::after{width:100%;}
.nav-cta{padding:9px 22px;background:var(--indigo);color:#fff!important;border-radius:100px;font-size:11.5px!important;letter-spacing:.1em!important;transition:all .3s!important;}
.nav-cta:hover{background:#3546d4!important;transform:translateY(-1px);box-shadow:0 6px 20px rgba(74,92,240,.35);}
.nav-cta::after{display:none!important;}

/* HERO */
.hero{min-height:100vh;display:grid;grid-template-columns:1.1fr 0.9fr;align-items:center;padding:120px 64px 80px;gap:80px;position:relative;overflow:hidden;}
.hero-orb1{position:absolute;width:700px;height:700px;background:radial-gradient(circle,rgba(74,92,240,.07) 0%,transparent 65%);top:-200px;right:-150px;border-radius:50%;pointer-events:none;animation:floatOrb 8s ease-in-out infinite;}
.hero-orb2{position:absolute;width:450px;height:450px;background:radial-gradient(circle,rgba(232,84,122,.05) 0%,transparent 65%);bottom:-100px;left:25%;border-radius:50%;pointer-events:none;animation:floatOrb 10s ease-in-out infinite reverse;}
.hero-orb3{position:absolute;width:300px;height:300px;background:radial-gradient(circle,rgba(74,155,122,.04) 0%,transparent 65%);top:30%;left:-80px;border-radius:50%;pointer-events:none;animation:floatOrb 12s ease-in-out infinite;}

.hero-left{position:relative;z-index:2;}
.h-badge{display:inline-flex;align-items:center;gap:8px;padding:7px 18px;background:var(--indigo-l);border-radius:100px;font-size:11px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--indigo);margin-bottom:28px;opacity:0;animation:fadeUp .7s .2s forwards;}
.h-dot{width:6px;height:6px;background:var(--indigo);border-radius:50%;animation:pulse 2s infinite;}
.h-name{font-family:'Playfair Display',serif;font-size:clamp(52px,5.5vw,84px);font-weight:500;line-height:.98;color:var(--text);opacity:0;animation:fadeUp .8s .35s forwards;}
.h-name em{font-style:italic;color:var(--indigo);}
.h-cn{font-family:'Noto Serif SC',serif;font-size:19px;font-weight:300;letter-spacing:.55em;color:var(--muted);margin-top:14px;opacity:0;animation:fadeUp .8s .5s forwards;}

/* Self summary */
.h-summary{margin-top:28px;padding:24px 28px;background:var(--white);border-radius:16px;border-left:3px solid var(--indigo);box-shadow:var(--shadow-s);font-size:14px;line-height:1.9;color:var(--text2);opacity:0;animation:fadeUp .8s .65s forwards;}
.h-summary strong{color:var(--indigo);font-weight:500;}

.h-actions{display:flex;gap:14px;margin-top:28px;opacity:0;animation:fadeUp .8s .8s forwards;}
.btn-primary{display:inline-flex;align-items:center;gap:8px;padding:13px 28px;background:var(--indigo);color:#fff;border-radius:100px;font-size:13px;font-weight:500;letter-spacing:.06em;text-decoration:none;border:none;cursor:pointer;transition:all .3s;}
.btn-primary:hover{background:#3546d4;transform:translateY(-2px);box-shadow:0 10px 30px rgba(74,92,240,.35);}
.btn-outline{display:inline-flex;align-items:center;gap:8px;padding:13px 28px;background:transparent;color:var(--text);border:1.5px solid var(--border);border-radius:100px;font-size:13px;font-weight:400;letter-spacing:.06em;text-decoration:none;cursor:pointer;transition:all .3s;}
.btn-outline:hover{border-color:var(--indigo);color:var(--indigo);transform:translateY(-2px);}

/* Hero right card */
.hero-right{position:relative;z-index:2;opacity:0;animation:fadeIn 1s .9s forwards;}
.id-panel{background:var(--white);border-radius:28px;padding:44px;box-shadow:var(--shadow-l);position:relative;overflow:hidden;}
.id-panel::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,var(--indigo),var(--rose),var(--amber),var(--sage));}

.id-avatar{width:92px;height:92px;border-radius:50%;background:linear-gradient(135deg,var(--indigo-l),var(--indigo-m));display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:28px;color:var(--indigo);font-weight:500;margin-bottom:20px;border:2px solid rgba(74,92,240,.2);overflow:hidden;box-shadow:0 8px 24px rgba(74,92,240,.14);}
.id-avatar img{display:block;width:100%;height:100%;object-fit:cover;object-position:50% 30%;}
.id-name-en{font-family:'Playfair Display',serif;font-size:24px;font-weight:500;margin-bottom:2px;}
.id-name-cn{font-family:'Noto Serif SC',serif;font-size:13px;letter-spacing:.35em;color:var(--muted);margin-bottom:20px;}

.id-info-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:24px;}
.id-info-item{padding:12px 16px;background:var(--bg);border-radius:12px;}
.id-info-label{font-size:10px;letter-spacing:.15em;text-transform:uppercase;color:var(--muted);margin-bottom:4px;}
.id-info-val{font-size:13px;font-weight:500;color:var(--text);}

.id-chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:24px;}
.id-chip{display:flex;align-items:center;gap:6px;padding:7px 14px;background:var(--bg);border-radius:100px;font-size:12px;color:var(--text2);transition:all .3s;cursor:default;}
.id-chip:hover{background:var(--indigo-l);color:var(--indigo);transform:translateY(-2px);}

.id-divider{height:1px;background:var(--border);margin-bottom:20px;}
.id-contact{display:flex;flex-direction:column;gap:8px;}
.id-contact-item{display:flex;align-items:center;gap:10px;font-size:13px;color:var(--text2);}
.id-contact-icon{width:28px;height:28px;border-radius:8px;background:var(--indigo-l);display:flex;align-items:center;justify-content:center;font-size:13px;flex-shrink:0;}

/* SECTIONS */
section{padding:96px 64px;max-width:1240px;margin:0 auto;}
.bg-w{background:var(--white);padding:96px 0;}
.bg-inner{max-width:1240px;margin:0 auto;padding:0 64px;}
.eyebrow{display:flex;align-items:center;gap:12px;font-size:11px;letter-spacing:.25em;text-transform:uppercase;color:var(--indigo);font-weight:500;margin-bottom:12px;}
.eyebrow-line{width:28px;height:2px;background:var(--indigo);border-radius:2px;}
.sec-title{font-family:'Playfair Display',serif;font-size:clamp(30px,3.5vw,48px);font-weight:500;line-height:1.15;margin-bottom:48px;color:var(--text);}

/* INTENT BAR */
.intent-bar{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-bottom:0;}
.intent-card{background:var(--white);border:1px solid var(--border);border-radius:var(--r);padding:28px 24px;text-align:center;transition:all .35s;position:relative;overflow:hidden;}
.intent-card::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,var(--indigo-l),transparent);opacity:0;transition:opacity .35s;}
.intent-card:hover::before{opacity:1;}
.intent-card:hover{transform:translateY(-5px);box-shadow:var(--shadow-m);border-color:rgba(74,92,240,.2);}
.intent-icon{font-size:26px;margin-bottom:12px;}
.intent-label{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:6px;}
.intent-val{font-size:15px;font-weight:600;color:var(--text);}

/* STATS */
.stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--border);border-radius:var(--r);overflow:hidden;margin-bottom:56px;}
.stat-card{background:var(--white);padding:36px 28px;text-align:center;transition:background .3s;}
.stat-card:hover{background:var(--indigo-l);}
.stat-num{font-family:'Playfair Display',serif;font-size:44px;font-weight:500;color:var(--indigo);line-height:1;margin-bottom:6px;}
.stat-sup{font-size:20px;}
.stat-label{font-size:12px;color:var(--muted);letter-spacing:.06em;}

/* ACHIEVE */
.achieve-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}
.ac-card{background:var(--white);border:1px solid var(--border);border-radius:var(--r);padding:32px 28px;position:relative;overflow:hidden;transition:transform .35s,box-shadow .35s;}
.ac-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-m);}
.ac-top{position:absolute;top:0;left:0;right:0;height:3px;}
.ac-n{font-family:'Playfair Display',serif;font-size:48px;font-weight:500;line-height:1;color:var(--text);margin-bottom:8px;}
.ac-u{font-size:18px;color:var(--muted);}
.ac-lbl{font-size:14px;font-weight:500;margin-bottom:8px;}
.ac-desc{font-size:13px;line-height:1.8;color:var(--muted);}
.tag{display:inline-block;padding:4px 12px;border-radius:100px;font-size:11px;font-weight:500;letter-spacing:.07em;margin-bottom:18px;}
.ti{background:var(--indigo-l);color:var(--indigo);}
.tr{background:var(--rose-l);color:var(--rose);}
.ta{background:var(--amber-l);color:var(--amber);}
.ts{background:var(--sage-l);color:var(--sage);}

/* PROJECTS — accordion style */
.proj-list{display:flex;flex-direction:column;gap:16px;}
.proj-card{background:var(--white);border:1px solid var(--border);border-radius:var(--r);overflow:hidden;transition:box-shadow .35s;}
.proj-card:hover{box-shadow:var(--shadow-m);}
.proj-header{padding:32px 40px;display:grid;grid-template-columns:60px 1fr auto;gap:28px;align-items:center;cursor:pointer;transition:background .3s;}
.proj-header:hover{background:rgba(74,92,240,.02);}
.proj-num{font-family:'Playfair Display',serif;font-size:40px;font-weight:500;color:rgba(0,0,0,.07);line-height:1;}
.proj-head-right{text-align:right;}
.proj-title{font-family:'Playfair Display',serif;font-size:20px;font-weight:500;margin-bottom:6px;}
.proj-sub{font-size:13px;color:var(--muted);}
.proj-toggle{width:36px;height:36px;border-radius:50%;background:var(--bg);display:flex;align-items:center;justify-content:center;font-size:14px;transition:all .35s;flex-shrink:0;}
.proj-card.open .proj-toggle{background:var(--indigo);color:#fff;transform:rotate(45deg);}
.proj-body{max-height:0;overflow:hidden;transition:max-height .5s cubic-bezier(0.16,1,0.3,1);}
.proj-body-inner{padding:0 40px 36px;display:grid;grid-template-columns:1fr 280px;gap:48px;}
.proj-desc{font-size:14px;line-height:1.9;color:var(--text2);margin-bottom:20px;}
.proj-pills{display:flex;flex-wrap:wrap;gap:8px;}
.proj-pill{padding:5px 14px;background:var(--bg);border-radius:100px;font-size:12px;color:var(--text2);}
.proj-result{background:var(--indigo-l);border-radius:16px;padding:24px;text-align:center;}
.result-label{font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--indigo);margin-bottom:10px;opacity:.7;}
.result-val{font-family:'Playfair Display',serif;font-size:28px;font-weight:500;color:var(--indigo);line-height:1.2;}
.proj-result{display:flex;flex-direction:column;}
.result-visual{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22px;min-height:190px;margin-top:26px;padding-top:26px;border-top:1px solid rgba(172,145,235,.18);}
.result-icon{width:104px;height:104px;display:grid;place-items:center;border-radius:28px;background:radial-gradient(circle at 30% 20%,rgba(186,155,255,.18),rgba(118,81,197,.035));border:1px solid rgba(172,145,235,.19);box-shadow:0 12px 38px rgba(108,68,194,.10);color:#c1a9f1;}
.result-icon svg{width:52px;height:52px;fill:none;stroke:currentColor;stroke-width:1.4;stroke-linecap:round;stroke-linejoin:round;}
.result-cues{display:flex;flex-wrap:wrap;justify-content:center;gap:7px;}
.result-cue{font-size:10px;line-height:1.5;padding:5px 9px;border-radius:8px;background:rgba(160,125,232,.08);color:#bba9d9;border:1px solid rgba(172,145,235,.12);}
@media(max-width:900px){.result-visual{min-height:140px;}.result-icon{width:80px;height:80px;border-radius:22px;}.result-icon svg{width:42px;height:42px;}}
.proj-details{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin:0 0 20px;}
.proj-detail{padding:13px 15px;background:var(--bg);border-radius:12px;}
.proj-detail-label{font-size:10px;letter-spacing:.12em;color:var(--indigo);font-weight:600;margin-bottom:5px;}
.proj-detail-text{font-size:12px;line-height:1.7;color:var(--text2);}
.project-stage{display:inline-flex;align-items:center;gap:6px;margin-top:9px;padding:5px 10px;border-radius:999px;background:rgba(130,95,218,.10);border:1px solid rgba(156,125,230,.16);color:#ab93de;font-size:10px;line-height:1.3;letter-spacing:.04em;}
.project-stage::before{content:'';width:6px;height:6px;border-radius:50%;background:currentColor;box-shadow:0 0 0 3px rgba(155,123,227,.10);}

/* EVIDENCE-LED CONTENT */
.practice-grid,.principle-grid,.ai-proof-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;}
.practice-card,.principle-card,.ai-proof-card{background:var(--white);border:1px solid var(--border);border-radius:var(--r);padding:28px;box-shadow:0 12px 42px rgba(41,24,72,.04);}
.practice-kicker,.proof-state{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--indigo);margin-bottom:12px;font-weight:600;}
.practice-title,.principle-title,.ai-proof-title{font-size:16px;font-weight:600;color:var(--text);margin-bottom:10px;}
.practice-desc,.principle-desc,.ai-proof-desc{font-size:13px;line-height:1.8;color:var(--muted);}
.practice-result{margin-top:18px;padding-top:16px;border-top:1px solid var(--border);font-size:12px;line-height:1.7;color:var(--text2);}
.practice-result strong{color:var(--indigo);font-size:18px;font-weight:600;}
.principle-grid{margin:0 0 30px;}
.principle-card{padding:22px 24px;}
.principle-icon{font-size:22px;margin-bottom:12px;}
.ai-proof-section{padding-top:72px;padding-bottom:72px;}
.ai-proof-card{position:relative;overflow:hidden;}
.ai-proof-card::before{content:'';position:absolute;left:0;right:0;top:0;height:3px;background:linear-gradient(90deg,#7157d9,#a88cf0);}
.proof-flow{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-top:18px;}
.proof-node{padding:6px 9px;border-radius:8px;background:var(--indigo-l);color:var(--indigo);font-size:10px;line-height:1.4;}
.proof-arrow{font-size:11px;color:var(--muted);}
.ai-eval-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:18px;}
.eval-card{padding:18px;background:linear-gradient(145deg,rgba(255,255,255,.88),rgba(247,244,252,.82));border:1px solid var(--border);border-radius:14px;}
.eval-title{font-size:12px;font-weight:600;color:var(--text);margin-bottom:7px;}
.eval-desc{font-size:11px;line-height:1.7;color:var(--muted);}

/* TRAITS */
.traits-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;}
.trait-card{background:var(--white);border:1px solid var(--border);border-radius:var(--r);padding:30px 26px;transition:transform .35s,box-shadow .35s;position:relative;overflow:hidden;}
.trait-card::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;transform:scaleX(0);transform-origin:left;transition:transform .4s;}
.trait-card:hover{transform:translateY(-5px);box-shadow:var(--shadow-m);}
.trait-card:hover::after{transform:scaleX(1);}
.tc-i::after{background:var(--indigo);} .tc-r::after{background:var(--rose);} .tc-a::after{background:var(--amber);} .tc-s::after{background:var(--sage);}
.t-icon{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px;margin-bottom:16px;}
.ic-i{background:var(--indigo-l);} .ic-r{background:var(--rose-l);} .ic-a{background:var(--amber-l);} .ic-s{background:var(--sage-l);}
.trait-title{font-size:14px;font-weight:600;margin-bottom:8px;}
.trait-desc{font-size:13px;line-height:1.85;color:var(--muted);}

/* SKILLS */
.skills-wrap{display:grid;grid-template-columns:1fr 1fr;gap:48px;}
.skill-group-title{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--indigo);font-weight:500;margin-bottom:20px;}
.skill-item{margin-bottom:18px;}
.skill-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;}
.skill-name{font-size:13px;font-weight:400;color:var(--text);}
.skill-usage{font-size:11px;color:var(--muted);letter-spacing:.05em;}
.skill-bar{display:none;}
.skill-row{align-items:flex-start;gap:20px;padding:13px 15px;background:var(--white);border:1px solid var(--border);border-radius:12px;}
.skill-name{font-weight:500;flex:0 0 38%;line-height:1.6;}
.skill-usage{max-width:58%;line-height:1.6;text-align:right;letter-spacing:0;}
.skill-fill{height:100%;background:linear-gradient(90deg,var(--indigo),rgba(74,92,240,.5));border-radius:3px;transform:scaleX(0);transform-origin:left;transition:transform 1.2s cubic-bezier(0.16,1,0.3,1);}
.skill-item.vis .skill-fill{transform:scaleX(1);}

/* tool tags */
.tools-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:8px;}
.tool-tag{display:flex;align-items:center;gap:8px;width:100%;min-width:0;padding:10px 18px;background:var(--white);border:1px solid var(--border);border-radius:12px;font-size:13px;color:var(--text2);transition:all .3s;}
.tool-tag:hover{border-color:var(--indigo);color:var(--indigo);transform:translateY(-2px);box-shadow:var(--shadow-s);}
.tool-emoji{font-size:16px;}
.language-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;}
.language-card{display:flex;align-items:center;justify-content:space-between;gap:14px;min-width:0;padding:14px 16px;background:var(--white);border:1px solid var(--border);border-radius:12px;box-shadow:0 10px 36px rgba(43,25,76,.04);}
.language-name{font-size:13px;font-weight:500;color:var(--text);}
.language-level{font-size:11px;line-height:1.4;color:var(--muted);text-align:right;}

/* METHODS */
.method-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:18px;}
.method-grid-2{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;}
.m-card{background:var(--white);border:1px solid var(--border);border-radius:var(--r);padding:30px 26px;transition:all .35s;}
.m-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-m);border-color:rgba(74,92,240,.2);}
.m-num{font-family:'Playfair Display',serif;font-size:36px;font-weight:500;color:rgba(74,92,240,.1);line-height:1;margin-bottom:12px;}
.m-title{font-size:14px;font-weight:600;color:var(--text);margin-bottom:8px;}
.m-desc{font-size:13px;line-height:1.85;color:var(--muted);}

/* TIMELINE */
.tl{position:relative;padding-left:28px;}
.tl::before{content:'';position:absolute;left:0;top:14px;bottom:14px;width:2px;background:linear-gradient(var(--indigo),rgba(74,92,240,.08));}
.tl-item{position:relative;margin-bottom:44px;opacity:0;transform:translateX(-16px);transition:opacity .6s,transform .6s;}
.tl-item.vis{opacity:1;transform:translateX(0);}
.tl-dot{position:absolute;left:-35px;top:10px;width:10px;height:10px;background:var(--indigo);border:2px solid var(--white);border-radius:50%;box-shadow:0 0 0 3px rgba(74,92,240,.2);}
